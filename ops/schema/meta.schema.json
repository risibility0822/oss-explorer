{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "ep-NNN-slug/meta.json：本集唯一資料來源（register 會把它寫進 data/*.json）",
 "type": "object",
 "required": [
  "no",
  "id",
  "date",
  "title",
  "oneliner",
  "domain",
  "format",
  "tier",
  "lens",
  "resources",
  "demo",
  "highlights",
  "tags",
  "slug",
  "ideas",
  "sources",
  "nextHint"
 ],
 "properties": {
  "no": {
   "type": "integer",
   "minimum": 1
  },
  "id": {
   "type": "string",
   "pattern": "^ep-\\d{3}$"
  },
  "date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "title": {
   "type": "string",
   "minLength": 4,
   "maxLength": 60
  },
  "oneliner": {
   "type": "string",
   "minLength": 10,
   "maxLength": 140
  },
  "domain": {
   "enum": [
    "AI 模型與推論",
    "AI 應用與 Agent 框架",
    "開發者工具",
    "資料庫與後端基礎設施",
    "自架服務 self-hosted",
    "開放資料集",
    "前端・設計・UI・字體・圖示",
    "多媒體",
    "地圖與地理空間",
    "科學・數學・生醫・氣候",
    "隱私・安全・網路",
    "硬體・IoT・嵌入式・機器人",
    "生產力・知識管理・桌面 App",
    "好玩・怪奇・創意程式・藝術"
   ]
  },
  "format": {
   "enum": [
    "單品",
    "組合技"
   ]
  },
  "tier": {
   "enum": [
    "巨星",
    "寶石",
    "新星"
   ]
  },
  "lens": {
   "enum": [
    "厲害",
    "好玩",
    "商業潛力"
   ]
  },
  "resources": {
   "type": "array",
   "minItems": 1,
   "maxItems": 5,
   "items": {
    "type": "object",
    "required": [
     "name",
     "url",
     "license",
     "stars",
     "lang"
    ],
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1
     },
     "url": {
      "type": "string",
      "pattern": "^https://"
     },
     "license": {
      "type": "string",
      "minLength": 1
     },
     "stars": {
      "type": [
       "string",
       "integer"
      ]
     },
     "lang": {
      "type": "string"
     },
     "role": {
      "enum": [
       "main",
       "support"
      ]
     },
     "title": {
      "type": "string",
      "description": "卡片上顯示的名字（例如 Headroom），不填就用 repo 名"
     },
     "what": {
      "type": "string",
      "maxLength": 30,
      "description": "一句白話：它是什麼（例如「送給 AI 前先壓縮內容的 Python 套件」）"
     },
     "commercial": {
      "type": "string",
      "maxLength": 24,
      "description": "能不能商用的結論（例如「可免費商用」「商用要付費」）"
     }
    }
   }
  },
  "demo": {
   "type": "string",
   "minLength": 10,
   "maxLength": 200
  },
  "highlights": {
   "type": "array",
   "minItems": 3,
   "maxItems": 3,
   "items": {
    "type": "string",
    "minLength": 6,
    "maxLength": 90
   }
  },
  "tags": {
   "type": "array",
   "maxItems": 6,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "slug": {
   "type": "string",
   "pattern": "^ep-\\d{3}-[a-z0-9-]+$"
  },
  "ideas": {
   "type": "array",
   "minItems": 3,
   "maxItems": 5,
   "items": {
    "type": "object",
    "required": [
     "title",
     "pitch",
     "effort",
     "value"
    ],
    "additionalProperties": false,
    "properties": {
     "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
     },
     "pitch": {
      "type": "string",
      "minLength": 15,
      "maxLength": 220
     },
     "effort": {
      "enum": [
       "一個週末",
       "一個月",
       "長期"
      ]
     },
     "value": {
      "type": "string",
      "minLength": 4,
      "maxLength": 120
     }
    }
   }
  },
  "sources": {
   "type": "array",
   "minItems": 5,
   "items": {
    "type": "string",
    "pattern": "^https://"
   }
  },
  "poolAdd": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "url",
     "domain",
     "why"
    ],
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1
     },
     "url": {
      "type": "string",
      "pattern": "^https://"
     },
     "domain": {
      "enum": [
       "AI 模型與推論",
       "AI 應用與 Agent 框架",
       "開發者工具",
       "資料庫與後端基礎設施",
       "自架服務 self-hosted",
       "開放資料集",
       "前端・設計・UI・字體・圖示",
       "多媒體",
       "地圖與地理空間",
       "科學・數學・生醫・氣候",
       "隱私・安全・網路",
       "硬體・IoT・嵌入式・機器人",
       "生產力・知識管理・桌面 App",
       "好玩・怪奇・創意程式・藝術"
      ]
     },
     "why": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "wish": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "id",
    "reply"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "reply": {
     "type": "string",
     "minLength": 1
    },
    "status": {
     "enum": [
      "done",
      "blocked"
     ]
    }
   }
  },
  "wishUpdates": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id"
    ]
   }
  },
  "nextHint": {
   "type": "string",
   "minLength": 6,
   "maxLength": 120
  },
  "createdAt": {
   "type": "string"
  },
  "review": {
   "type": "object"
  },
  "trend": {
   "type": "object",
   "description": "熱門話題日必填：這集接上了哪個熱門話題（來自 oss.py radar 的 data/trends.json）",
   "required": [
    "kind",
    "topic",
    "source",
    "date",
    "why"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "enum": [
      "public",
      "dev"
     ]
    },
    "topic": {
     "type": "string"
    },
    "source": {
     "type": "string"
    },
    "url": {
     "type": "string",
     "pattern": "^https://"
    },
    "date": {
     "type": "string"
    },
    "traffic": {
     "type": "string"
    },
    "why": {
     "type": "string",
     "maxLength": 60
    }
   }
  },
  "palette": {
   "type": "object",
   "description": "主題色出處：和田三造《配色事典》的組別（只能由 oss.py palette 寫入）",
   "required": [
    "source",
    "combo",
    "accent",
    "stage",
    "colors",
    "why"
   ],
   "additionalProperties": false,
   "properties": {
    "source": {
     "enum": [
      "wada"
     ]
    },
    "combo": {
     "type": "integer",
     "minimum": 1,
     "maximum": 348
    },
    "accent": {
     "type": "integer",
     "minimum": 1,
     "maximum": 4
    },
    "stage": {
     "type": "integer",
     "minimum": 1,
     "maximum": 4
    },
    "colors": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
     },
     "minItems": 2,
     "maxItems": 4
    },
    "names": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "why": {
     "type": "string",
     "maxLength": 60
    },
    "url": {
     "type": "string"
    }
   }
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "format": {
      "const": "組合技"
     }
    }
   },
   "then": {
    "properties": {
     "resources": {
      "minItems": 2
     }
    }
   }
  }
 ]
}
