{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "array",
 "items": {
  "type": "object",
  "required": [
   "no",
   "id",
   "date",
   "title",
   "oneliner",
   "domain",
   "format",
   "tier",
   "lens",
   "resources",
   "demo",
   "highlights",
   "tags",
   "path",
   "lab",
   "createdAt"
  ],
  "properties": {
   "no": {
    "type": "integer",
    "minimum": 1
   },
   "id": {
    "type": "string",
    "pattern": "^ep-\\d{3}$"
   },
   "date": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
   },
   "title": {
    "type": "string",
    "minLength": 4,
    "maxLength": 60
   },
   "oneliner": {
    "type": "string",
    "minLength": 10,
    "maxLength": 140
   },
   "domain": {
    "enum": [
     "AI 模型與推論",
     "AI 應用與 Agent 框架",
     "開發者工具",
     "資料庫與後端基礎設施",
     "自架服務 self-hosted",
     "開放資料集",
     "前端・設計・UI・字體・圖示",
     "多媒體",
     "地圖與地理空間",
     "科學・數學・生醫・氣候",
     "隱私・安全・網路",
     "硬體・IoT・嵌入式・機器人",
     "生產力・知識管理・桌面 App",
     "好玩・怪奇・創意程式・藝術"
    ]
   },
   "format": {
    "enum": [
     "單品",
     "組合技"
    ]
   },
   "tier": {
    "enum": [
     "巨星",
     "寶石",
     "新星"
    ]
   },
   "lens": {
    "enum": [
     "厲害",
     "好玩",
     "商業潛力"
    ]
   },
   "resources": {
    "type": "array",
    "minItems": 1,
    "maxItems": 5,
    "items": {
     "type": "object",
     "required": [
      "name",
      "url",
      "license",
      "stars",
      "lang"
     ],
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1
      },
      "url": {
       "type": "string",
       "pattern": "^https://"
      },
      "license": {
       "type": "string",
       "minLength": 1
      },
      "stars": {
       "type": [
        "string",
        "integer"
       ]
      },
      "lang": {
       "type": "string"
      },
      "role": {
       "enum": [
        "main",
        "support"
       ]
      },
      "title": {
       "type": "string",
       "description": "卡片上顯示的名字（例如 Headroom），不填就用 repo 名"
      },
      "what": {
       "type": "string",
       "maxLength": 30,
       "description": "一句白話：它是什麼（例如「送給 AI 前先壓縮內容的 Python 套件」）"
      },
      "commercial": {
       "type": "string",
       "maxLength": 24,
       "description": "能不能商用的結論（例如「可免費商用」「商用要付費」）"
      }
     }
    }
   },
   "demo": {
    "type": "string",
    "minLength": 10,
    "maxLength": 200
   },
   "highlights": {
    "type": "array",
    "minItems": 3,
    "maxItems": 3,
    "items": {
     "type": "string",
     "minLength": 6,
     "maxLength": 90
    }
   },
   "tags": {
    "type": "array",
    "maxItems": 6,
    "items": {
     "type": "string",
     "minLength": 1
    }
   },
   "path": {
    "type": "string",
    "pattern": "^ep-\\d{3}-[a-z0-9-]+/$"
   },
   "lab": {
    "type": "string"
   },
   "thumb": {
    "type": [
     "string",
     "null"
    ]
   },
   "createdAt": {
    "type": "string"
   },
   "trend": {
    "type": "object"
   }
  }
 }
}